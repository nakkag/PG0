/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規(&N)\tCtrl+N",              ID_MENUITEM_NEW
        MENUITEM "開く(&O)...\tCtrl+O",           ID_MENUITEM_OPEN
        MENUITEM "上書き保存(&S)\tCtrl+S",           ID_MENUITEM_SAVE
        MENUITEM "名前を付けて保存(&A)...",             ID_MENUITEM_SAVEAS
        MENUITEM "EXEファイルを作成(&E)...",           ID_MENUITEM_GEN_EXE
        MENUITEM SEPARATOR
        MENUITEM "オンラインを開く(&B)...",             ID_MENUITEM_ONLINE_OPEN
        MENUITEM "オンラインに保存(&I)...",             ID_MENUITEM_ONLINE_SAVE
        MENUITEM "変更履歴(&H)...",                 ID_MENUITEM_ONLINE_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "フォント(&F)...",                 ID_MENUITEM_FONT
        MENUITEM "行番号(&L)",                     ID_MENUITEM_LINE_NO
        MENUITEM SEPARATOR
        MENUITEM "PG0.5(&P)",                   ID_MENUITEM_PG05
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)",                      ID_MENUITEM_CLOSE
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z",            ID_MENUITEM_UNDO
        MENUITEM "やり直し(&R)\tCtrl+Y",            ID_MENUITEM_REDO
        MENUITEM SEPARATOR
        MENUITEM "切り取り(&T)\tCtrl+X",            ID_MENUITEM_CUT
        MENUITEM "コピー(&C)\tCtrl+C",             ID_MENUITEM_COPY
        MENUITEM "貼り付け(&P)\tCtrl+V",            ID_MENUITEM_PASTE
        MENUITEM "削除(&D)\tDel",                 ID_MENUITEM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "検索(&F)...\tCtrl+F",           ID_MENUITEM_FIND
        MENUITEM "次を検索(&N)\tF3",                ID_MENUITEM_FINDNEXT
        MENUITEM SEPARATOR
        MENUITEM "すべて選択(&A)\tCtrl+A",           ID_MENUITEM_SELECT_ALL
    END
    POPUP "実行(&X)"
    BEGIN
        MENUITEM "実行(&E)\tF5",                  ID_MENUITEM_EXEC
        MENUITEM "ステップ実行(&T)\tF10",             ID_MENUITEM_STEP
        MENUITEM "カーソル行まで実行(&R)\tCtrl+F10",     ID_MENUITEM_RUN_TO_CURSOR
        MENUITEM "停止(&S)\tShift+F5",            ID_MENUITEM_STOP
        MENUITEM SEPARATOR
        POPUP "実行速度(&P)"
        BEGIN
            MENUITEM "待ち無し(&W)",                    ID_MENUITEM_NO_WAIT
            MENUITEM SEPARATOR
            MENUITEM "速い(&H)",                      ID_MENUITEM_SPEED_HIGH
            MENUITEM "普通(&M)",                      ID_MENUITEM_SPEED_MID
            MENUITEM "遅い(&L)",                      ID_MENUITEM_SPEED_LOW
        END
        MENUITEM SEPARATOR
        MENUITEM "実行結果のクリア(&C)\tCtrl+Del",      ID_MENUITEM_CLEAR
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "チュートリアル(&T)...",              ID_MENUITEM_TUTORIAL
        MENUITEM SEPARATOR
        MENUITEM "バージョン情報(&A)...",              ID_MENUITEM_ABOUT
    END
END


