IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_MENUITEM_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_MENUITEM_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_MENUITEM_SAVE
        MENUITEM "Save &As...",                 ID_MENUITEM_SAVEAS
        MENUITEM "Create &EXE file...",         ID_MENUITEM_GEN_EXE
        MENUITEM SEPARATOR
        MENUITEM "&Browse online...",           ID_MENUITEM_ONLINE_OPEN
        MENUITEM "Save to onl&ine...",          ID_MENUITEM_ONLINE_SAVE
        MENUITEM "Revision &history...",        ID_MENUITEM_ONLINE_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "&Font...",                    ID_MENUITEM_FONT
        MENUITEM "&Line number",                ID_MENUITEM_LINE_NO
        MENUITEM SEPARATOR
        MENUITEM "&PG0.5",                      ID_MENUITEM_PG05
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_MENUITEM_CLOSE
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_MENUITEM_UNDO
        MENUITEM "&Redo\tCtrl+Y",               ID_MENUITEM_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_MENUITEM_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_MENUITEM_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_MENUITEM_PASTE
        MENUITEM "De&lete\tDel",                ID_MENUITEM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",            ID_MENUITEM_FIND
        MENUITEM "Find &Next\tF3",              ID_MENUITEM_FINDNEXT
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",         ID_MENUITEM_SELECT_ALL
    END
    POPUP "E&xec"
    BEGIN
        MENUITEM "&Exec\tF5",                   ID_MENUITEM_EXEC
        MENUITEM "S&tep exec\tF10",             ID_MENUITEM_STEP
        MENUITEM "Exec to Curso&r\tCtrl+F10",   ID_MENUITEM_RUN_TO_CURSOR
        MENUITEM "&Stop\tShift+F5",             ID_MENUITEM_STOP
        MENUITEM SEPARATOR
        POPUP "Exec s&peed"
        BEGIN
            MENUITEM "No &Wait",                    ID_MENUITEM_NO_WAIT
            MENUITEM SEPARATOR
            MENUITEM "&Fast",                       ID_MENUITEM_SPEED_HIGH
            MENUITEM "&Normal",                     ID_MENUITEM_SPEED_MID
            MENUITEM "&Slow",                       ID_MENUITEM_SPEED_LOW
        END
        MENUITEM SEPARATOR
        MENUITEM "&Clear console\tCtrl+Del",    ID_MENUITEM_CLEAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Tutorial....",               ID_MENUITEM_TUTORIAL
        MENUITEM SEPARATOR
        MENUITEM "&About...",                   ID_MENUITEM_ABOUT
    END
END


