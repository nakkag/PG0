IDR_ACCELERATOR ACCELERATORS
BEGIN
    VK_F5,          ID_MENUITEM_EXEC,       VIRTKEY, NOINVERT
    "F",            ID_MENUITEM_FIND,       VIRTKEY, CONTROL, NOINVERT
    VK_F3,          ID_MENUITEM_FINDNEXT,   VIRTKEY, NOINVERT
    "N",            ID_MENUITEM_NEW,        VIRTKEY, CONTROL, NOINVERT
    "O",            ID_MENUITEM_OPEN,       VIRTKEY, CONTROL, NOINVERT
    VK_F10,         ID_MENUITEM_RUN_TO_CURSOR, VIRTKEY, CONTROL, NOINVERT
    "S",            ID_MENUITEM_SAVE,       VIRTKEY, CONTROL, NOINVERT
    "A",            ID_MENUITEM_SELECT_ALL, VIRTKEY, CONTROL, NOINVERT
    VK_F10,         ID_MENUITEM_STEP,       VIRTKEY, NOINVERT
    VK_F5,          ID_MENUITEM_STOP,       VIRTKEY, SHIFT, NOINVERT
    VK_DELETE,      ID_MENUITEM_CLEAR,      VIRTKEY, CONTROL, NOINVERT
END


